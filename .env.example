# Обязательно. В проде — длинная случайная строка: openssl rand -base64 32
SESSION_SECRET=change-me

# База. Локально и на заводском сервере — файл рядом с проектом.
DB_FILE=./data.db

# Облачный стенд на Turso. Если задано, DB_FILE не используется.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Кнопки быстрого входа на странице входа. Показываются по умолчанию.
# На боевом контуре поставьте 0.
SHOW_DEMO_LOGINS=

# Закрывает /api/health. Пусто = эндпоинт открыт, удобно на стенде.
HEALTH_TOKEN=

# HTTP-сервис 1С. Пусто = очередь копится, ничего не отправляется.
ONEC_URL=
ONEC_USER=
ONEC_PASSWORD=
# Токен для вызова POST /api/sync по расписанию
SYNC_TOKEN=
