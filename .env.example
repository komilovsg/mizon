# Обязательно. В проде — длинная случайная строка: openssl rand -base64 32
SESSION_SECRET=change-me

# База. Локально и на заводском сервере — файл рядом с проектом.
DB_FILE=./data.db

# Облачный стенд на Turso. Если задано, DB_FILE не используется.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Печатать ли демо-доступы на странице входа. На публичном стенде оставьте пустым.
SHOW_DEMO_LOGINS=1

# HTTP-сервис 1С. Пусто = очередь копится, ничего не отправляется.
ONEC_URL=
ONEC_USER=
ONEC_PASSWORD=
# Токен для вызова POST /api/sync по расписанию
SYNC_TOKEN=
